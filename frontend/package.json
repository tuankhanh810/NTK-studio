{
  "name": "ntk-studio",
  "productName": "NTK Studio",
  "version": "1.2.0",
  "description": "NTK Studio - Universal AI Coding IDE. Sáng tạo không giới hạn.",
  "author": "NTK Studio Team",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build:vite": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:vite && npm run build:electron",
    "dist": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^40.8.0",
    "electron-builder": "^26.7.1",
    "tailwindcss": "^4.2.0",
    "typescript": "~5.7.2",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "com.ntkstudio.ide",
    "productName": "NTK Studio",
    "directories": {
      "output": "../release"
    },
    "win": {
      "icon": "public/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "NTK Studio",
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico",
      "deleteAppDataOnUninstall": false,
      "artifactName": "NTK Studio Setup ${version}.${ext}"
    },
    "portable": {
      "artifactName": "NTK Studio ${version} Portable.${ext}"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "../release/backend/ntk_backend",
        "to": "backend_dist/ntk_backend"
      }
    ]
  }
}
